resource "tofukit_feature" "ui_rabbit_delivery" {
  name = "ui_rabbit_delivery"
  description = "Friendly rabbit character illustration for Lightning-Fast Delivery section"
  files = {
    "rabbit_delivery.png" = tofukit_file.ui_rabbit_delivery
  }
  requirements = [
    {
      name = "Character Illustration for Delivery Section"
      instructions = [
        {
          prompt = <<-PROMPT
            **Business Context:**
            Friendly anthropomorphic rabbit character illustration for the Lightning-Fast Delivery section.
            
            **Usage Location:**
            - Homepage: Lightning-Fast Delivery section (right side of image-text split)
            - Brand identity: Mascot for delivery messaging
            
            **Marketing Purpose:**
            - Personify the delivery service with a relatable character
            - Reinforce rabbit/carrot thematic branding
            - Create emotional connection with users
            - Make delivery messaging feel friendly and approachable
            - Appeal to family audience
            
            **Character Requirements:**
            - Must appear friendly and welcoming (not aggressive or scary)
            - Must have carrot-themed elements for brand consistency
            - Must feel professional yet playful
            
            **Implementation:**
            Image file generated by $${tofukit_file.ui_rabbit_delivery.link}
          PROMPT
          constraints = [
            "Character must appear friendly - negative emotions reduce trust",
            "Must include carrot theme elements - brand consistency required",
          ]
        },
      ]
    },
  ]
}

resource "tofukit_feature" "ui_logo_carrot" {
  name = "ui_logo_carrot"
  description = "Brand logo featuring carrot icon for header navigation and brand identity"
  files = {
    "logo_carrot.png" = tofukit_file.ui_logo_carrot
  }
  requirements = [
    {
      name = "Brand Logo Display"
      instructions = [
        {
          prompt = <<-PROMPT
            **Business Context:**
            Brand logo with carrot icon displayed in header navigation for immediate brand recognition.
            
            **Usage Location:**
            - Header: Top-left corner of homepage next to "Carrot Labs" text
            - Brand identity: Primary visual identifier for the company
            
            **Brand Requirements:**
            - Must convey fresh, organic, farm-to-table personality
            - Must be recognizable at small sizes (32px minimum)
            - Must work on light green background
            - Carrot icon reinforces product focus
            
            **Implementation:**
            Image file generated by $${tofukit_file.ui_logo_carrot.link}
          PROMPT
          constraints = [
            "Must maintain aspect ratio when scaled",
            "Must be legible at 32px minimum size",
          ]
        },
      ]
    },
  ]
}

resource "tofukit_feature" "ui_paper_bag_carrots" {
  name = "ui_paper_bag_carrots"
  description = "Product photo of fresh carrots in brown paper bag for Garden-Fresh section"
  files = {
    "paper_bag_carrots.png" = tofukit_file.ui_paper_bag_carrots
  }
  requirements = [
    {
      name = "Product Photo for Garden-Fresh Section"
      instructions = [
        {
          prompt = <<-PROMPT
            **Business Context:**
            Product photo showcasing fresh carrots in the Garden-Fresh, Always Crunchy section of the homepage.
            
            **Usage Location:**
            - Homepage: Garden-Fresh section (left side of image-text split)
            - Marketing: Product quality and freshness messaging
            
            **Marketing Purpose:**
            - Reinforce farm-to-table branding
            - Showcase product freshness and quality
            - Create appetite appeal for organic produce
            - Demonstrate harvest-to-delivery promise
            
            **Visual Requirements:**
            - Must show vibrant orange carrots with green tops (freshness indicator)
            - Must use warm, natural lighting (farm-fresh atmosphere)
            - Must feel authentic, not overly staged
            - Brown paper bag suggests eco-friendly packaging
            
            **Implementation:**
            Image file generated by $${tofukit_file.ui_paper_bag_carrots.link}
          PROMPT
          constraints = [
            "Must show green carrot tops prominently - key freshness indicator",
            "Must use warm color temperature - cold tones reduce appetite appeal",
          ]
        },
      ]
    },
  ]
}

resource "tofukit_feature" "ui_rabbit_family" {
  name = "ui_rabbit_family"
  description = "Family of rabbit characters illustration for customer testimonials and community section"
  files = {
    "rabbit_family.png" = tofukit_file.ui_rabbit_family
  }
  requirements = [
    {
      name = "Character Illustration for Community Section"
      instructions = [
        {
          prompt = <<-PROMPT
            **Business Context:**
            Family group of anthropomorphic rabbit characters for the 'Thousands of Happy Hoppers' testimonials section.
            
            **Usage Location:**
            - Homepage: Testimonials section (left side of content)
            - Community messaging: Shows diverse customer base
            
            **Marketing Purpose:**
            - Represent diverse customer community
            - Create relatable family-friendly brand image
            - Reinforce rabbit/carrot thematic branding
            - Appeal to family demographic with multi-generational appeal
            - Make testimonials feel more personal and trustworthy
            
            **Character Requirements:**
            - Must show 3-4 rabbits of different sizes (family group)
            - Must appear friendly and welcoming
            - Must have variety in character design (different fur colors/patterns)
            - Professional 3D rendering quality
            
            **Implementation:**
            Image file generated by $${tofukit_file.ui_rabbit_family.link}
          PROMPT
          constraints = [
            "Characters must appear friendly - negative emotions reduce trust",
            "Must show clear variety in characters - represents diverse customer base",
          ]
        },
      ]
    },
  ]
}

resource "tofukit_feature" "ui_weather_sun" {
  name = "ui_weather_sun"
  description = "Weather sun icon for environmental conditions display in weather widget"
  files = {
    "weather_sun.png" = tofukit_file.ui_weather_sun
  }
  requirements = [
    {
      name = "Weather Icon for Conditions Widget"
      instructions = [
        {
          prompt = <<-PROMPT
            **Business Context:**
            Sun icon for the weather widget displaying current growing conditions for carrot farming.
            
            **Usage Location:**
            - Homepage: Weather widget section showing 25° Clear Sky
            - Displays alongside temperature and humidity data
            
            **UX Purpose:**
            - Visual indicator of sunny weather conditions
            - Part of weather information system
            - Reinforces real-time farming conditions data
            
            **Design Requirements:**
            - Must be flat design style matching weather UI conventions
            - Must be readable at small sizes (48-64px)
            - Must work on white background
            - Orange/coral color matching brand palette
            
            **Implementation:**
            Image file generated by $${tofukit_file.ui_weather_sun.link}
          PROMPT
          constraints = [
            "Must use flat design - 3D effects look inconsistent with weather UI",
            "Must be readable at 48px - weather widgets are compact",
          ]
        },
      ]
    },
  ]
}